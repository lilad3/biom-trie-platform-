# Configuration de biometric-core (biometric_core.config.Settings).
# Ce fichier suffit pour utiliser biometric-core de façon totalement
# indépendante, dans n'importe quel projet Python — sans FastAPI, sans API,
# sans rien d'autre. Copier vers .env dans le répertoire de travail.

# Clé AES-256-GCM : 32 octets encodés en base64. Générer avec :
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
BIOMETRIC_ENCRYPTION_KEY=

# Seuils d'extraction et de matching biométrique (SIFT/FLANN/RANSAC)
MIN_GOOD_MATCHES=18
LOWE_RATIO_THRESHOLD=0.75
RANSAC_REPROJ_THRESHOLD=7.5
FLANN_INDEX_KDTREE=1

# Validation des images reçues avant extraction
MAX_IMAGE_SIZE=5242880
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=4000
