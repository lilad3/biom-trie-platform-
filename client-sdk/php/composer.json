{
    "name": "biometric-platform/biometric-client",
    "description": "SDK officiel PHP pour biometric-api : enroll/identify/verify/delete sans cURL manuel ni calcul de signature HMAC.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "BiometricClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BiometricClient\\Tests\\": "tests/"
        }
    }
}
