# Configuration de biometric-api. Ce service dépend de biometric-core, donc
# ce fichier doit contenir À LA FOIS les paramètres HTTP (app.config.ApiSettings)
# et les paramètres biométriques (biometric_core.config.Settings) : les deux
# Settings lisent le même .env, chacun ne retenant que ce qui le concerne.
# Copier vers .env à la racine de biometric-platform (ou de biometric-api
# si lancé isolément).

# ============================================================
# app.config.ApiSettings — paramètres HTTP / service
# ============================================================
SERVICE_NAME=biometric-api
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
DEBUG=False

# Jeton partagé pour l'authentification HMAC inter-services (voir app/security/auth.py).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_AUTH_TOKEN=

# Fenêtre de tolérance (secondes) contre le rejeu des requêtes signées
SIGNATURE_TOLERANCE_SECONDS=30

# Rate limiting par IP
IDENTIFY_RATE_LIMIT=10/minute
ENROLL_RATE_LIMIT=20/minute
VERIFY_RATE_LIMIT=10/minute
# En production multi-workers, utiliser redis:// pour un compteur partagé
RATE_LIMIT_STORAGE_URI=memory://

# Origines autorisées à appeler cette API (jamais "*" pour des données biométriques)
ALLOWED_ORIGINS=["http://127.0.0.1:8000"]

# ============================================================
# biometric_core.config.Settings — paramètres biométriques
# (voir biometric-core/.env.example pour le détail de chaque variable)
# ============================================================
BIOMETRIC_ENCRYPTION_KEY=

MIN_GOOD_MATCHES=18
LOWE_RATIO_THRESHOLD=0.75
RANSAC_REPROJ_THRESHOLD=7.5
FLANN_INDEX_KDTREE=1

MAX_IMAGE_SIZE=5242880
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=4000
